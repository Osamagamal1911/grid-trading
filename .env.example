########## SHARED - ##########

# Relative to packages/prisma/src
DATABASE_URL="file:../../../dev.db"
ADMIN_PASSWORD=opentrader
# Logging level for ccxt
# Accepts: "true" | ""
CCXT_VERBOSE=
# Custom HOST. Default is localhost
HOST=
# Custom port. Default is 4000
PORT=
# Path to custom strategies dir. Should be a full path.
CUSTOM_STRATEGIES_PATH=
########## SHARED END ######

########## alphaGrid S3 — Binance credentials (env ONLY, never files/DB) ##########
# Source of truth for Binance secrets. When set, they WIN over any stored values
# (in-memory substitution at exchange-construction time; nothing is persisted).
# Local testnet flow (per shell, values stay on this machine):
#   export BINANCE_API_KEY="$(sed -n 's/^key: //p' binance-test-net)"
#   export BINANCE_API_SECRET="$(sed -n 's/^secret: //p' binance-test-net)"
# Key requirements: trading permission ONLY, withdrawals DISABLED, IP whitelist,
# sub-account recommended. Testnet keys first; live keys only on human approval.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# "true" (default) = Binance testnet via sandbox mode. Explicit "false" = LIVE.
BINANCE_TESTNET=true
# "true" = local PaperExchange simulator (no keys required). Default "false".
BINANCE_PAPER=false
